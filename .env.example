# Long-lived Instagram User access token (Instagram API with Instagram Login).
IG_ACCESS_TOKEN=
# Your Instagram professional account ID (run `python -m igauto whoami` -> user_id).
IG_USER_ID=
# App secret from Meta App Dashboard > Instagram > API setup (used to verify webhooks).
IG_APP_SECRET=
# Any random string; paste the same value into the webhook "Verify token" field.
IG_WEBHOOK_VERIFY_TOKEN=
# Optional
IG_GRAPH_VERSION=v23.0
IG_DB_PATH=data/igauto.db
IG_RULES_PATH=config/rules.json
